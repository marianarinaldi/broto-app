rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // O app acadêmico ainda não possui login. Estas regras permitem a
    // demonstração do CRUD com o projeto Firebase de teste.
    // Antes de publicar na Google Play, habilite Firebase Auth e substitua
    // estas regras por validações baseadas em request.auth.uid.
    match /plants/{plantId} {
      allow read, write: if true;
    }

    match /plant_catalog/{plantId} {
      allow read, write: if true;
    }
  }
}
